{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "legal:generate": "node scripts/generate-license-notices.mjs",
    "predev": "npm run sync:pdfjs && npm run legal:generate",
    "prebuild": "npm run sync:pdfjs && npm run legal:generate",
    "pretest": "npm run sync:pdfjs && npm run legal:generate",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "PDF_DEPLOY_TARGET=cloudflare npm run build",
    "check:cloudflare": "node scripts/check-cloudflare-build.mjs && node scripts/check-pdfjs-delivery.mjs",
    "test:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "ci:cloudflare": "npm run lint && npm run typecheck && npm test && npm run build:cloudflare && npm run check:cloudflare && npm run test:cloudflare",
    "deploy:cloudflare": "npm run check:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node scripts/qa-browser-editor.mjs && node --test scripts/pdf-safety.test.mjs scripts/legal-resources.test.mjs",
    "lint": "oxlint app components/pdf-editor.tsx components/legal-page.tsx components/company-details.tsx legal --ignore-pattern 'components/ui/**'",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "oxfmt"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "type": "module"
}
